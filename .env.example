# Dawatnama environment
# The platform runs fully in local-repository mode when these are absent,
# so you can develop and demo without a Supabase project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used for share links, QR codes and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
